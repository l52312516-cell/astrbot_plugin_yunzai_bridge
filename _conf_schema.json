{
  "yunzai_url": {
    "description": "Yunzai 桥接服务地址",
    "type": "string",
    "default": "",
    "hint": "同机填写 http://127.0.0.1:1145；局域网填写 http://Yunzai服务器IP:1145。"
  },
  "token": {
    "description": "共享 Token",
    "type": "string",
    "default": "",
    "hint": "必须与 Yunzai 插件配置中的 token 完全一致。"
  },
  "request_timeout": {
    "description": "请求超时秒数",
    "type": "int",
    "default": 30,
    "min": 1,
    "max": 120
  },
  "reply_delivery_mode": {
    "description": "回复发送模式",
    "type": "string",
    "options": [
      "yunzai_native",
      "astrbot_forward",
      "capture_only"
    ],
    "labels": [
      "Yunzai 原生发送（推荐，最快）",
      "AstrBot 转发捕获图片",
      "仅捕获，不实际发送"
    ],
    "default": "yunzai_native",
    "hint": "三种模式互斥。原生发送失败的图片会自动回退到 AstrBot 转发，不会重复发送成功图片。"
  }
}
